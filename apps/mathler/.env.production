# Production — committed, non-sensitive defaults only.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Hosting (e.g. Vercel) sets PORT at runtime. Local `pnpm start` uses `next start -p 3002` in package.json.
# PORT=3002

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
