# Environment Configuration Template for Sensitive Data
# Copy this file to .env and fill in your actual values
# NEVER commit .env file - it contains sensitive data

# Required: Dynamic SDK environment ID
# Get this from https://app.dynamic.xyz/
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id_here

# E2E tests: Dynamic sandbox (get static OTP from https://app.dynamic.xyz/dashboard/developer/test-accounts)
# Email: use +dynamic_test before @ (e.g. test+dynamic_test@yourdomain.com)
E2E_TEST_EMAIL=
E2E_STATIC_OTP=

# E2E app URL (optional; defaults to http://localhost:3002)
PLAYWRIGHT_APP_URL=
