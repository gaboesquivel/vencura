# API URL reachable from simulator/device
# When using port forwarding (e.g. Cursor remote): http://localhost:3001
# When on VPN/same LAN: http://<vpc-ip>:3001
EXPO_PUBLIC_API_URL=

# Dynamic auth (required for Dynamic SDK login)
# Get from https://app.dynamic.xyz/dashboard/api
EXPO_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id
