                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "emailVerified": {
                          "anyOf": [
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "wallet": {
                          "type": "object",
                          "required": [
                            "chain",
                            "address"
                          ],
                          "properties": {
                            "chain": {
                              "type": "string"
                            },
                            "address": {
                              "type": "string"
                            }
                          }
                        },
                        "linkedWallets": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "id",
                              "chain",
                              "address"
                            ],
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "chain": {
