# JWT secret for token verification. Must match Fastify JWT_SECRET.
JWT_SECRET=default-jwt-secret-min-32-chars-for-dev

# Dynamic auth (required for Dynamic SDK login)
# Get from https://app.dynamic.xyz/dashboard/api
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id

# E2E tests: Dynamic sandbox (get static OTP from https://app.dynamic.xyz/dashboard/developer/test-accounts)
# Email: use +dynamic_test before @ (e.g. test+dynamic_test@yourdomain.com)
E2E_TEST_EMAIL=
E2E_STATIC_OTP=

# Optional: Google One Tap (client-side). Same value as Fastify GOOGLE_CLIENT_ID.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

NEWSAPI_KEY=xxxxxxx